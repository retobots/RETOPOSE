Dim swFeatData As Object
Set swFeatData = Part.FeatureManager.CreateDefinition(swFmFillet)

swFeatData.Initialize swConstRadiusFillet

Dim swEdge As Object
Dim edgesArray(3) As Object
Set swEdge = Part.SelectionManager.GetSelectedObject6(1, 1)
Set edgesArray(0)=swEdge
Set swEdge = Part.SelectionManager.GetSelectedObject6(2, 1)
Set edgesArray(1)=swEdge
Set swEdge = Part.SelectionManager.GetSelectedObject6(3, 1)
Set edgesArray(2)=swEdge
Set swEdge = Part.SelectionManager.GetSelectedObject6(4, 1)
Set edgesArray(3)=swEdge
Dim edgesVar As Variant
edgesVar=edgesArray
swFeatData.Edges = edgesVar

Dim swFace As Object
Dim facesArray(0) As Object
Set swFace = Part.SelectionManager.GetSelectedObject6(1, 1)
Set facesArray(0)=swFace
Dim facesVar As Variant
facesVar=facesArray
swFeatData.SetFaces 0, (facesVar)

Dim swFeat As Object
Dim featuresArray(0) As Object
Set swFeat = Part.SelectionManager.GetSelectedObject6(1, -1)
Set featuresArray(0)=swFeat
Dim featuresVar As Variant
featuresVar=featuresArray
swFeatData.Features = featuresVar

swFeatData.AsymmetricFillet = False
swFeatData.DefaultRadius = 0.003
swFeatData.ConicTypeForCrossSectionProfile = swFeatureFilletCircular
swFeatData.CurvatureContinuous = False
swFeatData.ConstantWidth = 0.003
swFeatData.IsMultipleRadius = False
swFeatData.OverflowType = swFilletOverFlowType_Default

Dim swFeature As Object
Set swFeature = Part.FeatureManager.CreateFeature(swFeatData)
